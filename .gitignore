# секреты и локальная конфигурация
.env
*.env

# конфиг машины разработчика (WSL): свои адреса, выключенные интеграции.
# Боевой config.yaml в git — локальные отличия держим отдельным файлом,
# запуск: go run ./cmd/server -config config.local.yaml (см. docs/DEV_WSL.md)
config.local.yaml

# Экспорт реалма Keycloak — внутри пользователи с credentials
/deployments/keycloak/import/
!.env.example

# собранные бинарники (якорь к корню — иначе матчит cmd/server, cmd/migrate, internal/server)
/bin/
/build/
*.exe
/dpmodule
/server
/migrate

# логи
*.log
/var/log/

# временное / IDE
/tmp/
.idea/
.vscode/
*.swp
.DS_Store

# клиентские seed-данные справочников — вне репозитория, грузятся per-deployment
_reference/seed/

# локальное файловое хранилище (загруженные файлы ЛК и т.п.) — вне репозитория
/_data/

# локальный dev-Keycloak (realm с тестовыми юзерами/паролями) — вне репозитория
deploy/keycloak/

# дампы БД (восстановление/бэкапы) — вне репозитория
*.dump

# config.yaml НЕ игнорируем (решение владельца 03.08.2026): это конфиг стенда,
# который забирает CI/CD — DevOps ждёт его в репозитории под этим именем.
# Секретов в нём нет: они объявлены шаблонами ${vault:<движок>/<путь>:<ключ>},
# значения подставляет Jenkins перед стартом. Конфиг боевого VPS — config.vps.yaml
# (тоже в git, секреты через env). Локальные отличия машины разработчика —
# config.local.yaml (правило выше).
/.env
