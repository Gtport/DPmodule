# В рантайм-образ попадает только bin/server (multi-stage), но всё перечисленное
# ниже незачем даже передавать демону: сборка от этого медленнее, а данные
# клиента оседают в промежуточном build-слое.
.git
.env
bin/

# Документация и заметки. Паттерны docker НЕ рекурсивны, поэтому нужны обе
# строки: *.md ловит только корень, **/*.md — вложенные (docs/, .claude/).
*.md
**/*.md
.claude/
docs/

# Данные и материалы, в сборке бинаря не участвующие.
# _reference/ — образцы кода gtport и seed справочников клиента (сам seed вне git)
# _data/ — загруженные файлы ЛК и планов
_reference/
_data/
deployments/
scripts/
*.dump
*.log
logs/
