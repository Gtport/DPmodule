# Секреты — ЗАПАСНОЙ путь для стендов без подстановки из Vault (машина
# разработчика, systemd с EnvironmentFile). Основной путь: секрет объявлен в
# config.yaml шаблоном ${vault:<движок>/<путь>:<ключ>} и резолвится CI/CD перед
# стартом. Приоритет — файл конфига; окружение читается, только когда поле пусто.
# Этот файл в git не уезжает (.gitignore).

# PostgreSQL
PG_PASSWORD=iqport

# Keycloak (only for confidential clients)
KEYCLOAK_CLIENT_SECRET=

# Сервис-аккаунт Keycloak: исходящие походы к провайдеру (client_credentials)
# KEYCLOAK_SA_CLIENT_SECRET=

# Токен бота MAX (рассылка форм)
# MAX_BOT_TOKEN=

# ЗАПАСНОЙ X-API-Key провайдера (дислокация АСУ + памятки) на случай отката
# с Keycloak: auth_mode=apikey. В конфиг этот ключ не выносится — имя переменной
# задаёт сам источник (data_source.auth_secret_key, дефолт ASU_TOKEN).
# ASU_TOKEN=
